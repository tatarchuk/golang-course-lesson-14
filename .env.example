# Copy to .env (git-ignored). The values match the docker-compose.yml defaults.

# Application (host run: go run ./cmd/api)
DATABASE_URL=postgres://albums:albums@localhost:5432/albums?sslmode=disable
PORT=8080
# Lesson 10: migrations, templates and static files are embedded in the binary. Set MIGRATIONS_PATH
# only to apply the SQL files of a directory instead of the embedded set (development override).
# MIGRATIONS_PATH=migrations
# Lesson 10: Secure flag of the web session cookie (albums_token); set to true behind TLS
COOKIE_SECURE=false

# Lesson 9: signs the login tokens (HS256). Generate your own, at least 32 bytes, for example
#   openssl rand -base64 48
# The server refuses this placeholder and anything shorter than 32 bytes.
JWT_SECRET=change-me-openssl-rand-base64-48-before-first-run

# Lesson 9: the administrator that `make bootstrap` creates or resets (development password, see README)
ADMIN_EMAIL=admin@albums.local
ADMIN_PASSWORD=Albums-Dev-2026

# Tests: go test ./... (the database is created by scripts/initdb on the first compose start)
TEST_DATABASE_URL=postgres://albums:albums@localhost:5432/albums_test?sslmode=disable

# docker compose: postgres container
POSTGRES_USER=albums
POSTGRES_PASSWORD=albums
POSTGRES_DB=albums
POSTGRES_PORT=5432
