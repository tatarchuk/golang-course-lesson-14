    "definitions": {
        "handler.ErrorDetail": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "not_found"
                },
                "message": {
                    "type": "string",
                    "example": "Album not found"
                }
            }
        },
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
