{
    "swagger": "2.0",
    "info": {
        "description": "REST API for a music album catalogue on PostgreSQL: genres, artists, albums and their physical copies. Reads are public; writes need a staff or admin bearer token from POST /auth/login.",
        "title": "Albums API",
        "contact": {},
        "version": "3.0"
    },
    "basePath": "/api/v1",
