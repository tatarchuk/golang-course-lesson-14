                    "type": "string"
                }
            }
        },
        "model.Album": {
            "type": "object",
            "properties": {
                "artists": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Artist"
                    }
                },
                "created_at": {
                    "description": "RFC 3339, set once on creation",
                    "type": "string"
                },
                "genre": {
                    "$ref": "#/definitions/model.Genre"
                },
                "genre_id": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "label": {
                    "type": "string"
                },
                "notes": {
                    "description": "null when not provided",
                    "type": "string"
                },
                "release_year": {
                    "description": "null when not provided",
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "updated_at": {
                    "description": "RFC 3339, changes on every PUT",
                    "type": "string"
                }
            }
        },
        "model.AlbumInput": {
            "type": "object",
            "required": [
                "artist_ids",
                "genre_id",
                "label",
                "title"
            ],
            "properties": {
                "artist_ids": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "genre_id": {
                    "type": "integer",
                    "example": 1
                },
                "label": {
                    "type": "string",
                    "example": "Columbia"
                },
                "notes": {
                    "type": "string",
                    "example": "Recorded in 1959"
                },
                "release_year": {
                    "type": "integer",
                    "example": 1959
                },
                "title": {
                    "type": "string",
                    "example": "Kind of Blue"
                }
            }
        },
        "model.Artist": {
            "type": "object",
            "properties": {
                "bio": {
                    "description": "null when not provided",
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "model.ArtistInput": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
